# Primary LiteLLM Proxy (OpenAI-compatible)
LITELLM_PROXY_URL=https://your-litellm-proxy.example.com/v1
LITELLM_API_KEY=
LITELLM_MODEL=chatgpt/gpt-5.3-instant
LITELLM_CODING_MODEL=chatgpt/gpt-5.3-codex
LITELLM_USER_AGENT=LLM-Provider-Router/1.0
LITELLM_TIMEOUT=45

# Optional secondary failover providers (leave blank if unused)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional local CLI fallback (set to 1 to allow `claude` / `codex` CLI fallback)
ROUTER_ENABLE_CLI_PROVIDERS=0

# Local OpenAI-compatible HTTP gateway (loopback only)
ROUTER_GATEWAY_HOST=127.0.0.1
ROUTER_GATEWAY_PORT=18766
ROUTER_GATEWAY_TOKEN=

# Cooldowns & spend circuit breaker (0 = unlimited)
ROUTER_COOLDOWN_BASE_SEC=30
ROUTER_COOLDOWN_MAX_SEC=600
ROUTER_DAILY_BUDGET_USD=0
ROUTER_STATE_DB=
